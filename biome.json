{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["js/**", "tests/**", "css/**", "!css/tailwind.css", "sw.js", "package.json", "biome.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "none" }
  },
  "css": {
    "formatter": { "enabled": true, "quoteStyle": "double" }
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
